                  /> */}
                  <SearchInput
                    onSearch={() => {}}
                    place_holder="Αναζήτηση Ασθενών"
                  />
                </div>
                <div className={styles.dropdown}>
                    <select title="filters" name="filters" value={sortOption} onChange={handleSortChange}>
                        <option value="" hidden disabled>{<IoFilter/>}Ταξινόμηση Κατά</option>
                        <option value="alphabetical">Αλφαβητική Σειρά</option>
                        <option value="newest">Πρόσφατες Εγγραφές</option>
                        <option value="oldest">Παλαιότερες Εγγραφές</option>
                    </select>
                  </div>
                  <div className={styles.register_patient}>
                      <AddButton
                        onRegister={navToRegisterPatientPage}
                        value="Προσθήκη Ασθενή"
                      >
                        Προσθήκη Ασθενή
                      </AddButton>
                  </div>
              </div>
            <div className={styles.tableN}>
                {/* {sortedFilteredPatients.length > 0 ? (
                  <div className={styles.table}>
                    <div className={styles.tableHeader}>
                      <div className={styles.tableHeaderCell}>Oνοματεπώνυμο</div>
                      <div className={styles.tableHeaderCell}>AMKA</div>
                      <div className={styles.tableHeaderCell}>Κινητό</div>
                      <div className={styles.tableHeaderCell}>Στάδιο</div>
                      <div className={styles.tableHeaderCell}>Επιβλέπων Ιατρός</div>
                      <div className={styles.tableHeaderCell}>Ημ/νια Εγγραφής</div>
                      <div className={styles.tableHeaderCell}></div>
                    </div>
                    {sortedFilteredPatients.map((patient: any) => (
                      <div
                        className={styles.tableRow}
                        key={patient.id}
                        onClick={() => handleNavigateToPatient(patient._id, patient.id)}
                      >
                        <div className={styles.tableCell}>
                          <div className={styles.tableCellDiff}>
                            <b>{highlightMatch(patient.firstname, searchTerm)} {highlightMatch(patient.lastname, searchTerm)}</b>
