                          </div>
                        </div>
                        <div className={styles.tableCell}>
                          {highlightMatch(patient.amka, searchTerm)}
                        </div>
                        <div className={styles.tableCell}>
                          {highlightMatch(patient.mobilephone, searchTerm)}
                        </div>
                        <div
                          className={`${styles.tableCell} ${
                            patient.currentStage === "ΠΡΟΕΓΧΕΙΡΗΤΙΚΟ"
                              ? styles.preOperationStage
                              : styles.postOperationStage
                          }`}
                        >
                          {highlightMatch(patient.currentStage, searchTerm)}
                        </div>
                        <div className={styles.tableCell}>
                          {highlightMatch(patient.supervisorDoctor, searchTerm)}
                        </div>
                        <div className={styles.tableCell}>
                          {new Date(patient.createdAt).toLocaleDateString()}
                        </div>
                        <div className={styles.tableCell}>
                          <button
                            type="button"
                            title="delete"
                            onClick={(e) => {
                              e.stopPropagation();
                              handleDeleteAction(patient._id, patient.firstname, patient.lastname);
                            }}
